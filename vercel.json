{
  "version": 2,
  "builds": [
    {
      "src": "chainvote/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "chainvote/wsgi.py"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/automatic-data-push/",
      "schedule": "0 0 * * *"
    }
  ]
}
