{
  "version": 2,
  "builds": [
    {
      "src": "chainvote/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": [
          "staticfiles/**",
          "voting/static/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/favicon.ico",
      "headers": {
        "cache-control": "public, max-age=86400, stale-while-revalidate=86400"
      },
      "dest": "chainvote/wsgi.py"
    },
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "chainvote/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "chainvote/wsgi.py"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/add-candidate/",
      "schedule": "0 0 * * *"
    }
  ]
}
